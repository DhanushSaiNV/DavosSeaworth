# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: For local development with Supabase CLI
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Optional: Manual auth redirect override (for LAN testing on Android)
# Set to your LAN URL + /auth/callback (e.g., http://192.168.x.x:8081/auth/callback)
# This bypasses Expo's auth proxy and goes direct to your dev server
# EXPO_PUBLIC_AUTH_REDIRECT_OVERRIDE=http://192.168.1.xxx:8081/auth/callback